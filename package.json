{
  "name": "@stxr/dsh-session-bridge",
  "version": "0.1.1",
  "description": "Let local applications open an exact DeepSeek Harness desktop session and confirm that its history loaded.",
  "author": "Stxr",
  "homepage": "https://github.com/Stxr/dsh-session-bridge#readme",
  "repository": { "type": "git", "url": "git+https://github.com/Stxr/dsh-session-bridge.git" },
  "bugs": { "url": "https://github.com/Stxr/dsh-session-bridge/issues" },
  "keywords": ["dsh-plugin", "deepseek-harness", "cordis", "session", "navigation", "desktop", "huantai"],
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/types/host/index.d.ts",
  "exports": {
    ".": { "types": "./lib/types/host/index.d.ts", "default": "./lib/index.js" },
    "./client": { "types": "./lib/types/client/index.d.ts", "default": "./lib/client.js" },
    "./bridge": { "types": "./lib/types/host/public.d.ts", "default": "./lib/bridge.js" },
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": ["lib/", "src/", "scripts/", "tsconfig.json", "tsconfig.build.json", "pnpm-lock.yaml", "cordis.patch.yml", "locale/*.json", "icon.svg", "README.md", "docs/*.md", "tests/*.test.js"],
  "engines": { "dsh": "0.2.2-rc.1" },
  "packageManager": "pnpm@10.17.1",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsx scripts/build.ts",
    "test": "tsx scripts/test.ts",
    "check": "tsc --noEmit && tsx scripts/test.ts"
  },
  "devDependencies": {
    "@types/node": "24.10.0",
    "esbuild": "0.25.12",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-connection", "@deepseek-ai/dsh-api-session-controller", "@deepseek-ai/dsh-api-workspace-controller", "@deepseek-ai/dsh-client-ui-workspace"]
    }
  }
}
